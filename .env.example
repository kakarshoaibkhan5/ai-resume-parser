# ---------------------------------------------------------------------------
# ai-resume-parser — example environment file
#
#   cp .env.example .env
#
# Every value below is optional; the defaults shown are what the app uses when
# the variable is absent. Restart Streamlit after changing them.
# ---------------------------------------------------------------------------

# --- Identity ---------------------------------------------------------------
APP_NAME=ai-resume-parser
APP_DEBUG=false

# --- Models -----------------------------------------------------------------
# NER: token classification (person / org / location hints)
NER_MODEL_ID=dslim/bert-base-NER
# Summarisation: CNN abstractive summariser
SUMMARIZER_MODEL_ID=facebook/bart-large-cnn

# Where `scripts/download_models.py` stores weights. Paths are relative to the
# repository root unless absolute.
MODEL_CACHE_DIR=models/weights

# OFFLINE_MODE=true makes the app refuse to touch the network. Run the download
# script once while online, then ship the folder to the air-gapped host.
OFFLINE_MODE=false

# auto | cpu | cuda
DEVICE=auto

# Toggle individual components. Disable the summariser on very small hosts to
# cut RAM usage (~1.6 GB -> ~450 MB).
ENABLE_NER=true
ENABLE_SUMMARIZER=true
ENABLE_EMBEDDINGS=true

# --- PDF ingestion ----------------------------------------------------------
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20
MAX_RESUME_CHARS=40000

# Scanned PDFs need Tesseract + pytesseract installed on the host.
ENABLE_OCR=false

# --- Summarisation ----------------------------------------------------------
SUMMARY_BULLETS=3
SUMMARY_MAX_INPUT_CHARS=3600
SUMMARY_MAX_CHUNKS=2
SUMMARY_MAX_LENGTH=130
SUMMARY_MIN_LENGTH=30
SUMMARY_NUM_BEAMS=2

# --- Job matching weights (auto re-normalised) ------------------------------
MATCH_WEIGHT_SKILLS=0.50
MATCH_WEIGHT_SEMANTIC=0.25
MATCH_WEIGHT_EXPERIENCE=0.15
MATCH_WEIGHT_EDUCATION=0.10

# --- Operations -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
DEMO_MODE=false
